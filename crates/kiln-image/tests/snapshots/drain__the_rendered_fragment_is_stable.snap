# Generated by Kiln. Recreates /var on a machine whose /var is empty.
# /var must not exist in the commit.
d /var/cache 0755 root root -
d /var/home 0755 root root -
d /var/lib 0755 root root -
d /var/lib/fixture 0755 root root -
d /var/lib/fixture/private 0700 root root -
C /var/lib/fixture/seed.db - - - -
L /var/lock - - - - ../run/lock
d /var/log 0755 root root -
d /var/log/journal 2755 root systemd-journal -
d /var/log/old 0755 root root -
d /var/mnt 0755 root root -
d /var/opt 0755 root root -
d /var/roothome 0700 root root -
L /var/run - - - - ../run
d /var/srv 0755 root root -
