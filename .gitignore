# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# insta writes these next to accepted snapshots while a change is pending
**/*.snap.new

# The fixture pacman repository is generated by tests/repo-fixture/build.sh.
# Binary packages do not belong in git; the script that produces them does.
/tests/repo-fixture/repo/
/tests/repo-fixture/.work/

# The PKGBUILD is the source; everything else that appears here is makepkg's
# output — pkg/, src/, the built packages, and the git clone of the tag being
# packaged, whose name follows $pkgname-$pkgver and so cannot be matched once
# and for all. An allowlist, so a new kind of build artifact is ignored by
# default and anything genuinely belonging to the package has to say so.
/packaging/*
!/packaging/PKGBUILD
